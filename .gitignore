# This is a Go library module - no service/binary artifacts are ignored.

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go Workspace (library projects don't commit workspaces)
go.work
go.work.sum

# Go vendor (library projects don't commit vendor)
vendor/

# Coverage & profiling
coverage.*
*.coverprofile
*.prof
default.pgo

# IDE & editor
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & debug
*.log
logs/
*.pid

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# Allow cert/key fixtures under any testdata/ directory
!**/testdata/**/*.pem
!**/testdata/**/*.key

# Tooling cache
.task/

# Temp files
tmp/
temp/
*.tmp
